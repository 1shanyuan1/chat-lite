{
  "name": "chat-lite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync": "npm run build && cap sync",
    "selfcheck": "esbuild scripts/selfcheck.mjs --bundle --format=esm --platform=node --target=node20 --alias:@=./src --outfile=node_modules/.cache/selfcheck.mjs --log-level=error && node node_modules/.cache/selfcheck.mjs",
    "livecheck": "esbuild scripts/livecheck.mjs --bundle --format=esm --platform=node --target=node20 --alias:@=./src --outfile=node_modules/.cache/livecheck.mjs --log-level=error && node node_modules/.cache/livecheck.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.2",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "capacitor-stream-http": "^0.1.0",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
