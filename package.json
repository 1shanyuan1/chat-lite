{
  "name": "chat-lite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sketch": "node design/sketch-server.mjs",
    "build": "node scripts/pdfjs-assets.mjs && tsc --noEmit && vite build",
    "postinstall": "node scripts/pdfjs-assets.mjs",
    "preview": "vite preview",
    "sync": "npm run build && cap sync",
    "selfcheck": "esbuild scripts/selfcheck.mjs --bundle --format=esm --platform=node --target=node20 --alias:@=./src --alias:@/chat/pdf-worker=scripts/shims/pdf-worker-node.mjs --external:pdfjs-dist --outfile=node_modules/.cache/selfcheck.mjs --log-level=error && node node_modules/.cache/selfcheck.mjs",
    "livecheck": "esbuild scripts/livecheck.mjs --bundle --format=esm --platform=node --target=node20 --alias:@=./src --outfile=node_modules/.cache/livecheck.mjs --log-level=error && node node_modules/.cache/livecheck.mjs",
    "cap:sync": "npm run build && cap sync android",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "samples": "esbuild scripts/make-samples.ts --bundle --format=esm --platform=node --target=node20 --alias:@=./src --outfile=node_modules/.cache/samples.mjs --log-level=error && node node_modules/.cache/samples.mjs",
    "taverncheck": "esbuild scripts/taverncheck.mjs --bundle --format=esm --platform=node --alias:@=./src --outfile=.cache/taverncheck.mjs --log-level=error && node .cache/taverncheck.mjs",
    "tavernsweep": "esbuild scripts/tavernsweep.mjs --bundle --format=esm --platform=node --alias:@=./src --outfile=.cache/tavernsweep.mjs --log-level=error && node .cache/tavernsweep.mjs",
    "continuitycheck": "esbuild scripts/continuitycheck.mjs --bundle --format=esm --platform=node --alias:@=./src --outfile=.cache/continuitycheck.mjs --log-level=error && node .cache/continuitycheck.mjs",
    "evolvecheck": "esbuild scripts/evolvecheck.mjs --bundle --format=esm --platform=node --alias:@=./src --outfile=.cache/evolvecheck.mjs --log-level=error && node .cache/evolvecheck.mjs",
    "cardcase": "esbuild scripts/cardcase.mjs --bundle --format=esm --platform=node --alias:@=./src --outfile=node_modules/.cache/cardcase.mjs --log-level=error && node node_modules/.cache/cardcase.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.2",
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "capacitor-stream-http": "^0.1.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
